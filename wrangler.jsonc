{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nagokeysgithub",
  "compatibility_date": "2025-09-27",
  "observability": {
    "enabled": true
  },
  "main": "./_worker.js",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nagokeys",
      "database_id": "68d72ec4-9a11-4a06-946b-5d3f3088fa39",
      "migrations_dir": "migrations"
    }
  ]
}